# Pilih salah satu LLM provider:

# Option 1: OpenAI (paling populer, tapi berbayar)
OPENAI_API_KEY=your_openai_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo

# Option 2: DeepSeek (murah, cocok untuk OCR project ini)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat

# Option 3: Groq (gratis tier tersedia)
# GROQ_API_KEY=your_groq_api_key_here
# LLM_PROVIDER=groq
# LLM_MODEL=mixtral-8x7b-32768

# Option 4: Ollama (local, gratis, tidak perlu API key)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama2
# OLLAMA_BASE_URL=http://localhost:11434

# FAISS Settings
FAISS_INDEX_PATH=./faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
